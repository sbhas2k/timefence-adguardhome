# TimeFence for AdGuard Home - configuration
# Copy to /etc/timefence/timefence.env (chmod 600) or to .env for local runs.

# --- AdGuard Home -----------------------------------------------------------
ADGUARD_URL=http://127.0.0.1:3000
ADGUARD_USER=admin
# Use either ADGUARD_PASSWORD or ADGUARD_PASSWORD_FILE (file wins if both set)
ADGUARD_PASSWORD=
#ADGUARD_PASSWORD_FILE=/etc/timefence/adguard.pass

# --- web server -------------------------------------------------------------
# Path prefix, e.g. "/" or "/timer". No trailing slash.
BASE_PATH=/
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8099

# IANA timezone used for daily budgets and midnight reset.
# CHANGE ME: your IANA timezone, e.g. Europe/London.
TZ=UTC

# --- behaviour --------------------------------------------------------------
DATA_DIR=/var/lib/timefence
RECONCILE_INTERVAL=30
# Comma separated CIDRs whose X-Forwarded-For header is trusted.
TRUSTED_PROXIES=
# Set to false only for plain-HTTP development.
SECURE_COOKIES=true
LOG_LEVEL=INFO
